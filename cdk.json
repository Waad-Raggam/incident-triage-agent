{
  "app": "python3 -m infra.app",
  "watch": {
    "include": ["infra/**", "lambdas/**", "agent/**"],
    "exclude": ["**/__pycache__", "**/*.pyc", "cdk.out"]
  },
  "context": {
    "project": "incident-triage",
    "service_name": "checkout-api",
    "region": "us-east-1",
    "alert_email": "waadsraggam@gmail.com",
    "monthly_budget_usd": 30,
    "github_repo": "Waad-Raggam/incident-triage-agent",
    "create_github_oidc_provider": true,
    "model_id": "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
    "judge_model_id": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    "embedding_model_id": "amazon.titan-embed-text-v2:0",
    "prompt_version": "triage-v1",
    "anomaly_endpoint_name": "incident-anomaly",
    "servicenow_secret_name": "incident-triage/servicenow",
    "slack_secret_name": "incident-triage/slack",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true
  }
}
